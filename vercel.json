{
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.zft-group.com/$1",
      "has": [
        {
          "type": "host",
          "value": "zft-jade.vercel.app"
        }
      ],
      "permanent": true
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/" }]
}
